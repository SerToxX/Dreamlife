# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="mysql://dreamlife:DreamLife2024!@mysql:3306/dream_life"

# Para desarrollo local SIN Docker cambia a:
# DATABASE_URL="mysql://root:tu_password@localhost:3306/dream_life"

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_64_caracteres_minimo
JWT_REFRESH_SECRET=otra_clave_secreta_para_refresh_token_diferente_a_la_anterior
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─────────────────────────────────────────────
# UPLOADS
# ─────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ─────────────────────────────────────────────
# SMTP (correo del formulario de contacto)
# Si se dejan vacías, el mensaje solo se guarda en la BD y no se envía
# correo. Datos del correo profesional de GoDaddy (smtpout.secureserver.net,
# puerto 465 SSL o 587 TLS; usuario = el correo completo).
# ─────────────────────────────────────────────
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=dreamlife@dreamlifeperu.com
SMTP_PASS=
CONTACT_EMAIL_TO=dreamlife@dreamlifeperu.com

# ─────────────────────────────────────────────
# DATOS LEGALES (aparecen en el PDF del libro de reclamaciones)
# ─────────────────────────────────────────────
COMPANY_RAZON_SOCIAL=Dream Life
COMPANY_RUC=
