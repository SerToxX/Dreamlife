# ─── Copia este archivo como .env y edita los valores ───
DB_ROOT_PASSWORD=RootPass123!
DB_USER=dreamlife
DB_PASSWORD=DreamLife2024!
JWT_SECRET=cambia_esto_por_64_caracteres_aleatorios_en_produccion_XXXXXX
JWT_REFRESH_SECRET=otro_secreto_diferente_de_64_caracteres_en_produccion_YYYYYY
NODE_ENV=development

# ─── Producción: URLs públicas (ver dreamlife.md) ───
# En local dejar como está (localhost). En Coolify sobreescribir con los
# dominios reales, ej:
# FRONTEND_URL=https://dreamlifeperu.com
# NEXT_PUBLIC_API_URL=https://api.dreamlifeperu.com/api/v1
# NEXT_PUBLIC_SOCKET_URL=https://api.dreamlifeperu.com
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ─── SMTP (correo del formulario de contacto) ───
# Si se dejan vacías, el formulario de contacto solo guarda el mensaje en
# la BD y no envía correo.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=dreamlife@dreamlifeperu.com
SMTP_PASS=
CONTACT_EMAIL_TO=dreamlife@dreamlifeperu.com
